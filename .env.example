# Supabase project (Project settings > API). The anon key is safe in the browser:
# row-level security decides what it can read and write.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Checkout, the Stripe webhook, admin management, Instagram sync.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the site, used for links, emails and metadata.
NEXT_PUBLIC_SITE_URL=

# Stripe (Developers > API keys, and the webhook's signing secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend, for order emails. MAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=58 Diamonds <orders@58diamonds.com>
# Fallback for order and request notifications when Admin > Settings has no email.
ADMIN_EMAIL=

# The shop (bag, checkout, client accounts, Orders and Clients in the admin)
# stays hidden until this is "on".
NEXT_PUBLIC_SHOP=

# Optional. DeepL API key (deepl.com/pro-api, the free Developer plan is enough) for the
# admin's "Translate from ..." buttons.
DEEPL_API_KEY=

# Vercel Cron sends this as a bearer token to /api/instagram.
CRON_SECRET=

# Optional. With these set, a pasted Facebook token is exchanged for a
# 60-day one and refreshed automatically.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
